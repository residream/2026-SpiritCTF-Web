<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <% if (name === 'lock') { %><rect x="5" y="10" width="14" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><path d="M12 14v3"/>
  <% } else if (name === 'plus') { %><path d="M12 5v14M5 12h14"/>
  <% } else if (name === 'arrow') { %><path d="M5 12h14m-6-6 6 6-6 6"/>
  <% } else if (name === 'copy') { %><rect x="8" y="8" width="12" height="13" rx="2"/><path d="M15 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h3"/>
  <% } else if (name === 'check') { %><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/>
  <% } else if (name === 'note') { %><rect x="5" y="3" width="14" height="18" rx="3"/><path d="M9 8h6M9 12h6M9 16h4"/>
  <% } else { %><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7h.01"/><% } %>
</svg>
