<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f5f5f7">
  <title><%= title %> · 秘密便签</title>
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/style.css">
  <script src="/assets/main.js" defer></script>
</head>
<body class="<%= currentUser ? 'signed-in' : 'signed-out' %>">
  <a class="skip-link" href="#main">跳到正文</a>
  <div class="app-shell">
    <header class="brand">
      <a class="wordmark" href="/">秘密便签<span class="brand-dot">.</span></a>
      <p class="tagline">随手记录，仅自己可见。</p>
    </header>
    <% if (currentUser) { %>
    <nav class="navigation" aria-label="主导航">
      <a href="/notes" <%- nav === 'notes' ? 'aria-current="page"' : '' %>>我的便签</a>
      <a href="/notes/new" <%- nav === 'new' ? 'aria-current="page"' : '' %>>新建便签</a>
      <a href="/settings" <%- nav === 'settings' ? 'aria-current="page"' : '' %>>排序偏好</a>
    </nav>
    <% } %>
    <main id="main" class="main" tabindex="-1">
      <% if (feedback) { %><%- include('feedback', { feedback }) %><% } %>
      <%- body %>
    </main>
    <footer class="site-footer">所有便签仅自己可见。</footer>
  </div>
  <div class="toast" role="status" data-toast hidden></div>
</body>
</html>
