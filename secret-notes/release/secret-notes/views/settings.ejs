<section class="surface">
  <div class="panel-heading"><div><h1>排序偏好</h1><p class="subtitle">设置便签列表的排序方式。</p></div><span class="badge"><%= currentUser.username %></span></div>
  <p class="intro">便签按你选择的字段和顺序排列。</p>
  <form class="stack" action="/settings" method="post" data-submit-form>
    <div class="field-row">
      <label for="sort_field">排序字段</label>
      <select id="sort_field" name="sort_field">
        <option value="created_at" <%- sortField === 'created_at' ? 'selected' : '' %>>创建时间</option>
        <option value="title" <%- sortField === 'title' ? 'selected' : '' %>>标题</option>
        <option value="priority" <%- sortField === 'priority' ? 'selected' : '' %>>优先级</option>
      </select>
    </div>
    <div class="field-row">
      <label for="sort_dir">顺序</label>
      <select id="sort_dir" name="sort_dir">
        <option value="desc" <%- sortDir === 'asc' ? '' : 'selected' %>>降序</option>
        <option value="asc" <%- sortDir === 'asc' ? 'selected' : '' %>>升序</option>
      </select>
    </div>
    <button class="button button-primary full-width" type="submit" data-loading-label="正在保存…">保存排序偏好 <%- include('icons', { name: 'check' }) %></button>
  </form>
  <div class="settings-row"><span>当前账号</span><strong><%= currentUser.username %></strong></div>
  <form action="/logout" method="post" data-submit-form><button class="button button-secondary full-width" type="submit" data-loading-label="正在退出…">退出登录</button></form>
</section>
